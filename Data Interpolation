from __future__ import annotations

import numpy as np
from scipy.interpolate import LinearNDInterpolator
from scipy.spatial import Delaunay, QhullError, cKDTree


def _points(values: np.ndarray, name: str) -> np.ndarray:
    values = np.asarray(values, dtype=np.float64)
    if values.ndim != 2 or values.shape[1] != 3 or not len(values):
        raise ValueError(f"{name} must have shape (N, 3), N >= 1.")
    if not np.isfinite(values).all():
        raise ValueError(f"{name} contains non-finite coordinates.")
    return values


def _query(tree: cKDTree, points: np.ndarray, k: int):
    distances, indices = tree.query(points, k=k, workers=-1)
    if k == 1:
        distances, indices = distances[:, None], indices[:, None]
    return distances, indices


def _local_spacing(tree: cKDTree, points: np.ndarray, k: int, fallback: float):
    distances, _ = _query(tree, points, min(k, len(points)))
    spacing = distances[:, -1]
    positive = spacing[spacing > 0]
    floor = float(np.median(positive)) * 0.1 if len(positive) else fallback
    return np.maximum(spacing, floor)


def reconstruct_cartesian(
    coords_ref: np.ndarray,
    fields: np.ndarray,
    resolution: int = 64,
    k_neighbors: int = 4,
    power: float = 1.0,
    support_factor: float = 2.0,
    geometry_coords: np.ndarray | None = None,
    method: str = "linear_idw",
    grid_mode: str = "reference",
    minimum_axis_points: int = 8,
) -> tuple[np.ndarray, np.ndarray, np.ndarray, dict]:
    """Shared 3D linear interpolation with local IDW boundary extension.

    Coordinates are already scaled by the caller. Only ``fields`` supplies labels;
    optional geometry coordinates define the bounding box and point-cloud support.
    This is a piecewise-linear proxy, not Sibson natural-neighbor interpolation.
    """
    coords = _points(coords_ref, "coords_ref")
    fields = np.asarray(fields, dtype=np.float64)
    if fields.ndim == 1:
        fields = fields[:, None]
    if fields.ndim != 2 or fields.shape[0] != len(coords) or fields.shape[1] < 1:
        raise ValueError("fields must have shape (N, C), C >= 1.")
    if not np.isfinite(fields).all():
        raise ValueError("fields contains non-finite labels.")
    if method not in ("linear_idw", "idw"):
        raise ValueError("method must be 'linear_idw' or 'idw'.")
    if grid_mode not in ("reference", "aspect"):
        raise ValueError("grid_mode must be 'reference' or 'aspect'.")
    if int(resolution) != resolution or resolution < 4:
        raise ValueError("resolution must be an integer >= 4.")
    if int(minimum_axis_points) != minimum_axis_points or minimum_axis_points < 2:
        raise ValueError("minimum_axis_points must be an integer >= 2.")
    if int(k_neighbors) != k_neighbors or k_neighbors < 1:
        raise ValueError("k_neighbors must be an integer >= 1.")
    if not np.isfinite([power, support_factor]).all() or power <= 0 or support_factor <= 0:
        raise ValueError("power and support_factor must be finite and positive.")

    geometry = None if geometry_coords is None else _points(geometry_coords, "geometry_coords")
    support_coords = coords if geometry is None else geometry
    lower, upper = support_coords.min(axis=0), support_coords.max(axis=0)
    if grid_mode == "reference":
        axes = [np.linspace(-1.0, 1.0, int(resolution)) for _ in range(3)]
    else:
        spans = upper - lower
        if np.any(spans <= 0):
            raise ValueError("Aspect grid requires nonzero extent along all three axes.")
        shape = np.maximum(minimum_axis_points, np.rint(resolution * spans / spans.max()).astype(int))
        axes = [np.linspace(lo, hi, int(n)) for lo, hi, n in zip(lower, upper, shape)]
    grid = np.stack(np.meshgrid(*axes, indexing="ij"), axis=-1)
    targets = grid.reshape(-1, 3)
    shape = grid.shape[:3]
    spacing = np.array([axis[1] - axis[0] for axis in axes])
    grid_radius = float(np.linalg.norm(spacing) * 0.5)
    eps = np.finfo(float).eps * max(1.0, np.abs(support_coords).max(), np.abs(targets).max()) * 32

    tree = cKDTree(coords)
    k = min(int(k_neighbors), len(coords))
    distances, indices = _query(tree, targets, k)
    local_spacing = _local_spacing(tree, coords, 5, grid_radius)
    supported = distances[:, 0] <= np.maximum(support_factor * local_spacing[indices[:, 0]], grid_radius)
    supported &= np.all((targets >= lower - eps) & (targets <= upper + eps), axis=1)
    if geometry is not None:
        geometry_tree = cKDTree(geometry)
        geometry_spacing = _local_spacing(geometry_tree, geometry, 5, grid_radius)
        gd, gi = _query(geometry_tree, targets, 1)
        supported &= gd[:, 0] <= np.maximum(support_factor * geometry_spacing[gi[:, 0]], grid_radius)
    # Point-cloud support excludes distant cells but cannot certify unresolved holes.
    output = np.zeros((len(targets), fields.shape[1]), dtype=np.float64)
    exact = supported & (distances[:, 0] <= eps)
    linear_mask = np.zeros(len(targets), dtype=bool)
    if method == "linear_idw":
        try:
            # All observations enter one triangulation shared by every channel.
            triangulation = Delaunay(coords)
            interpolator = LinearNDInterpolator(triangulation, fields, fill_value=np.nan)
        except QhullError as error:
            raise ValueError(
                "3D Delaunay triangulation failed: the observed coordinates may be "
                "too few, coplanar or degenerate. Inspect the cloud or explicitly "
                "select method='idw'; no automatic method change was made."
            ) from error
        active = np.flatnonzero(supported)
        if len(active):
            interpolated = np.asarray(interpolator(targets[active])).reshape(len(active), fields.shape[1])
            finite = np.isfinite(interpolated).all(axis=1)
            linear_mask[active[finite]] = True
            output[active[finite]] = interpolated[finite]
        linear_mask |= exact

    idw_mask = supported & ~linear_mask
    ordinary = idw_mask & ~exact
    if ordinary.any():
        d = distances[ordinary]
        # The ratio form avoids overflow when the nearest observation is very close.
        weights = (d[:, :1] / d) ** power
        weights /= weights.sum(axis=1, keepdims=True)
        output[ordinary] = np.sum(fields[indices[ordinary]] * weights[..., None], axis=1)
    output[exact] = fields[indices[exact, 0]]
    output[~supported] = 0.0
    info = {
        "method": method,
        "grid_mode": grid_mode,
        "linear_count": int(linear_mask.sum()),
        "idw_count": int(idw_mask.sum()),
        "exact_count": int(exact.sum()),
        "unsupported_count": int((~supported).sum()),
        "observation_count": len(coords),
        "triangulation_point_count": len(coords) if method == "linear_idw" else 0,
        "geometry_point_count": len(support_coords),
        "grid_shape": list(shape),
        "spacing": spacing.tolist(),
        "k_neighbors": k,
        "power": float(power),
        "support_factor": float(support_factor),
        "support_mask": "local point-cloud distance and bounds; unresolved holes are not certified",
    }
    return grid, output.reshape(*shape, fields.shape[1]), supported.reshape(shape), info
