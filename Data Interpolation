import os
import numpy as np
import pandas as pd
from scipy.spatial import cKDTree
from scipy.interpolate import LinearNDInterpolator


def nondimensionalize_coordinates(coords, l_ref=None):
    """
    Nondimensionalize spatial coordinates strictly following Eq. 3 of GD-PINNs:
    x* = x / x_ref.

    Academic Note: If subsequent PINN optimization requires mapping coordinates
    to a strictly symmetric domain (e.g., [-1, 1]^3) for gradient stability,
    that affine translation should be handled inside the neural network's
    input layer rather than conflated with the physical nondimensionalization
    step defined in the manuscript.
    """
    if l_ref is None:
        # Define characteristic length scale as the maximum span across all dimensions
        coords_min = np.min(coords, axis=0)
        coords_max = np.max(coords, axis=0)
        l_ref = np.max(coords_max - coords_min)

    coords_norm = coords / l_ref
    return coords_norm, l_ref


def natural_neighbor_interpolation_proxy(coords_norm, solution_fields, resolution=64):
    """
    Resample unstructured fields onto a unified Cartesian grid.

    Academic Note: True 3D Natural-Neighbor (Sibson) interpolation provides C^1
    continuity globally. Due to the lack of native 3D Sibson interpolation in
    standard SciPy, this function employs Delaunay-based barycentric linear
    interpolation (LinearNDInterpolator) as an engineering proxy. While it is
    C^0 continuous, it effectively avoids spurious extrapolatory oscillations
    and preserves the dominant transport organization required for FFT/PSD analysis.
    """
    # Determine the bounding box for the normalized coordinates
    min_bounds = np.min(coords_norm, axis=0)
    max_bounds = np.max(coords_norm, axis=0)

    # Create a unified Cartesian grid bounding the physical domain
    grid_x, grid_y, grid_z = np.mgrid[
                             min_bounds[0]:max_bounds[0]:resolution * 1j,
                             min_bounds[1]:max_bounds[1]:resolution * 1j,
                             min_bounds[2]:max_bounds[2]:resolution * 1j
                             ]
    target_points = np.column_stack([grid_x.ravel(), grid_y.ravel(), grid_z.ravel()])

    num_channels = solution_fields.shape[1]
    structured_flat = np.zeros((target_points.shape[0], num_channels), dtype=np.float64)

    for c in range(num_channels):
        interpolator = LinearNDInterpolator(coords_norm, solution_fields[:, c])
        structured_flat[:, c] = interpolator(target_points)

        # Replace NaNs (grid points outside the Delaunay convex hull) with nearest-neighbor values
        # to ensure boundary completeness without introducing spectral artifacts
        nan_mask = np.isnan(structured_flat[:, c])
        if np.any(nan_mask):
            tree = cKDTree(coords_norm)
            _, nearest_idx = tree.query(target_points[nan_mask], k=1)
            structured_flat[nan_mask, c] = solution_fields[nearest_idx, c]

    return structured_flat.reshape((resolution, resolution, resolution, num_channels))


def extract_coarse_grid(structured_tensor, retain_ratio=0.3):
    """
    Topology-Preserving Coarse-Grid Conditioning.

    As specified in Section 4.4, uniform topology-preserving downsampling is
    performed using fixed spatial strides on the reconstructed Cartesian grid,
    rather than applying voxel filtering directly to the original unstructured mesh.
    """
    resolution = structured_tensor.shape[0]

    # Calculate the exact spatial stride required to achieve the target retain_ratio
    # Equation: (1 / stride)^3 ≈ retain_ratio  =>  stride ≈ (1 / retain_ratio)^(1/3)
    stride = max(1, int(np.round((1.0 / retain_ratio) ** (1.0 / 3.0))))

    # Apply uniform downsampling via stride slicing
    coarse_tensor = structured_tensor[::stride, ::stride, ::stride, :]

    actual_ratio = coarse_tensor.size / structured_tensor.size
    print(f"Applied spatial stride: {stride}")
    print(f"Target retention: {retain_ratio:.1%}, Actual retention: {actual_ratio:.1%}")

    return coarse_tensor


def process_unstructured_csv(csv_path, output_dir, resolution=64, retain_ratio=0.3):
    """
    Complete preprocessing pipeline mathematically conforming to GD-PINNs methodology.
    """
    # 1. Read high-fidelity unstructured CFD data
    df = pd.read_csv(csv_path)
    coords = df[["x", "y", "z"]].values
    fields = df[["u", "v", "w", "p"]].values

    # 2. Nondimensionalize coordinates via characteristic length scale (Eq. 3)
    coords_norm, l_ref = nondimensionalize_coordinates(coords)

    # 3. Reconstruct physical fields onto the unified Cartesian grid
    dense_tensor = natural_neighbor_interpolation_proxy(coords_norm, fields, resolution=resolution)

    # 4. Topology-preserving coarse-grid extraction (approx 30% retention)
    coarse_tensor = extract_coarse_grid(dense_tensor, retain_ratio=retain_ratio)

    # 5. Export structured tensors for spectral-physical descriptor extraction
    os.makedirs(output_dir, exist_ok=True)
    base = os.path.splitext(os.path.basename(csv_path))[0]

    dense_path = os.path.join(output_dir, f"{base}_cartesian_dense_{resolution}.npy")
    coarse_path = os.path.join(output_dir, f"{base}_cartesian_coarse_stride.npy")

    np.save(dense_path, dense_tensor)
    np.save(coarse_path, coarse_tensor)

    print(f"Dense tensor saved to: {dense_path}, shape: {dense_tensor.shape}")
    print(f"Coarse tensor saved to: {coarse_path}, shape: {coarse_tensor.shape}")


