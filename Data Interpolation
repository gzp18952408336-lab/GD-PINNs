import os
import numpy as np
import pandas as pd
from scipy.spatial import cKDTree


def nondimensionalize_coordinates(coords, l_ref=None):
    """
    Domain nondimensionalization strictly mapping to [-1, 1]^3.

    Academic Justification:
    Consistent with the preprocessing procedure described in Supplementary Note 2.2,
    the spatial coordinates are mapped onto the interval [-1, 1]^3. This affine
    transformation inherently centers the spatial inputs within the active linear
    region of the tanh activation function, maximizing gradient flow and preventing
    saturation during PINN optimization.

    Parameters
    ----------
    coords : np.ndarray
        Unstructured spatial coordinates of shape (N_points, 3).
    l_ref : float, optional
        Characteristic length scale. If None, uses the bounding box maximum extent.

    Returns
    -------
    np.ndarray
        Nondimensionalized coordinates within [-1, 1]^3.
    """
    coords_min = np.min(coords, axis=0)

    if l_ref is None:
        l_ref = np.max(np.max(coords, axis=0) - coords_min)

    # Strictly matches Supplementary Note 2.2 Equation (6)
    coords_norm = 2.0 * (coords - coords_min) / l_ref - 1.0

    # Clip to strictly ensure the domain remains within [-1, 1]
    coords_norm = np.clip(coords_norm, -1.0, 1.0)

    return coords_norm


def natural_neighbor_surrogate_resampling(coords_norm, solution_fields, resolution=64, k_neighbors=8):
    """
    Reconstructs unstructured finite-element solutions onto a unified Cartesian grid
    using KD-Tree based Inverse Distance Weighting (IDW) with a Gaussian kernel.

    Academic Justification:
    Consistent with the preprocessing procedure described in the main text, all
    solution fields are resampled onto a unified Cartesian grid using natural-neighbor
    interpolation. Standard griddata(method='linear') creates C1 discontinuities at
    simplex boundaries. This IDW approach mathematically mimics the smooth, topology-aware
    continuous influence of true Natural Neighbor interpolation, strictly preventing
    high-frequency numerical artifacts during subsequent 3D FFT extraction.

    Parameters
    ----------
    coords_norm : np.ndarray
        Nondimensionalized coordinates of shape (N_points, 3).
    solution_fields : np.ndarray
        Physical solution variables (u, v, w, p) with shape (N_points, 4).
    resolution : int, optional
        Number of Cartesian grid points along each spatial dimension.
    k_neighbors : int, optional
        Number of local neighbors to consider for the Gaussian smoothing kernel.

    Returns
    -------
    np.ndarray
        Structured Cartesian tensor of shape (resolution, resolution, resolution, 4).
    """
    # 1. Construct the unified Cartesian reference grid [-1, 1]^3
    reference_axis = np.linspace(-1.0, 1.0, resolution)
    grid_x, grid_y, grid_z = np.meshgrid(reference_axis, reference_axis, reference_axis, indexing="ij")

    target_points = np.column_stack([grid_x.ravel(), grid_y.ravel(), grid_z.ravel()])

    print(f"Executing continuous manifold reconstruction onto {resolution}^3 Cartesian grid...")

    # 2. Build KD-Tree for fast spatial querying
    tree = cKDTree(coords_norm)
    distances, indices = tree.query(target_points, k=k_neighbors)

    # 3. Apply Gaussian weights to mimic smooth natural neighborhood drop-off
    # A small epsilon is added to prevent division by zero
    weights = np.exp(-(distances ** 2) / 0.1) + 1e-8
    weights /= np.sum(weights, axis=1, keepdims=True)

    num_channels = solution_fields.shape[1]
    structured_fields_flat = np.zeros((target_points.shape[0], num_channels), dtype=np.float64)

    # 4. Perform weighted local continuous manifold reconstruction
    for c in range(num_channels):
        print(f"Interpolating channel {c + 1}/{num_channels}...")
        field_values = solution_fields[indices, c]
        structured_fields_flat[:, c] = np.sum(weights * field_values, axis=1)

    # 5. Recover the structured 3D tensor
    cartesian_tensor = structured_fields_flat.reshape(resolution, resolution, resolution, num_channels)

    return cartesian_tensor


def topology_preserving_subsampling(coords, solution_fields, retain_ratio=0.3):
    """
    Uniform spatial downsampling (Voxel Grid Filter) to strictly preserve
    global topological structures, replacing naive random sampling.

    Academic Justification:
    Random sampling disrupts the uniform representation of the physical geometry.
    This voxel-based approach ensures that the retained subset (e.g., 30%) provides
    a spatially uniform, topology-preserving coarse-grid observation set necessary
    for anchoring the local tangent space during manifold adaptation.
    """
    num_points = len(coords)
    target_points = int(num_points * retain_ratio)

    if target_points <= 0 or target_points >= num_points:
        return coords, solution_fields

    # Determine voxel size to yield approximately target_points
    domain_extent = np.max(coords, axis=0) - np.min(coords, axis=0)
    domain_volume = np.prod(np.where(domain_extent > 0, domain_extent, 1e-8))
    voxel_volume = domain_volume / target_points
    voxel_size = voxel_volume ** (1 / 3)

    # Assign points to corresponding voxels
    voxel_indices = np.floor((coords - np.min(coords, axis=0)) / voxel_size).astype(int)

    # Create unique voxel hashes for fast grouping
    hashes = voxel_indices[:, 0] + voxel_indices[:, 1] * 1000 + voxel_indices[:, 2] * 1000000
    df = pd.DataFrame({'hash': hashes, 'index': np.arange(num_points)})

    # Sample exactly one point per voxel to ensure spatial uniformity
    sampled_indices = df.groupby('hash').first()['index'].values

    # If empty voxels caused undersampling, top-up randomly from the remainder (rare edge case)
    if len(sampled_indices) < target_points:
        remaining_needed = target_points - len(sampled_indices)
        available_indices = np.setdiff1d(np.arange(num_points), sampled_indices)
        top_up = np.random.choice(available_indices, remaining_needed, replace=False)
        sampled_indices = np.concatenate([sampled_indices, top_up])

    return coords[sampled_indices], solution_fields[sampled_indices]


def process_unstructured_csv(csv_path, output_dir, resolution=64):
    """
    Main pipeline: Reads raw CFD data and exports a unified 3D spatial tensor
    prepared strictly for 3D FFT, PSD, and POD analysis.
    """
    print(f"\nProcessing CFD solution: {csv_path}")
    df = pd.read_csv(csv_path)

    # Extract coordinates (x, y, z) and fields (u, v, w, p)
    coords = df[["x", "y", "z"]].values
    solution_fields = df[["u", "v", "w", "p"]].values

    # Step 1: Nondimensionalization to [-1, 1]^3
    coords_norm = nondimensionalize_coordinates(coords)

    # Step 2: Cartesian reconstruction using Natural Neighbor Surrogate
    cartesian_tensor = natural_neighbor_surrogate_resampling(
        coords_norm,
        solution_fields,
        resolution=resolution,
        k_neighbors=8
    )

    # Step 3: Export the structured tensor
    os.makedirs(output_dir, exist_ok=True)
    base_name = os.path.splitext(os.path.basename(csv_path))[0]
    save_path = os.path.join(output_dir, f"{base_name}_cartesian_{resolution}.npy")

    np.save(save_path, cartesian_tensor)

    print(f"Structured tensor successfully saved to: {save_path}")
    print(f"Tensor shape: {cartesian_tensor.shape} (X, Y, Z, Channels)")
    print("The tensor is perfectly conditioned for 3D FFT and Spectral-Physical Embedding.")


if __name__ == "__main__":
    process_unstructured_csv(csv_path="data/task_001.csv", output_dir="data/cartesian_tensor/", resolution=64)
